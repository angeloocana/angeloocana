{
  "name": "angelo-ocana",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "build": "NODE_ENV=production node --import remix/node-tsx scripts/build.ts",
    "preview": "npm run build && npx wrangler@4.151.1 dev",
    "deploy": "npm run build && npx wrangler@4.151.1 deploy"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "marked": "18.1.0",
    "remix": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
