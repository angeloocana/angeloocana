#!/usr/bin/env bash
# Enable in each clone: git config core.hooksPath .githooks
# CI may pass a base commit to check the PR's indexed tree against instead of HEAD.
set -euo pipefail
shopt -s nocasematch

scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT
git diff --cached ${1:+"$1"} --name-only --diff-filter=ACMR -z > "$scratch/staged"
[ -s "$scratch/staged" ] || exit 0

fail=0
file_number=0
# A filename may itself contain personal data; log only its position and the reason.
block() { printf 'Blocked staged file %s: %s\n' "$file_number" "$1" >&2; fail=1; }
credentials='(^|/)(\.env(\..*)?|\.dev\.vars(\..*)?|\.wrangler(/.*)?|.*\.(pem|key|p12|pfx|crt|csr|keystore)|id_(rsa|ed25519)|.*credentials.*\.json|\.npmrc)$'
private_media='(^|/)(index/(items|montages|reviews|ig-posts|cut-drafts|cut-checks|config)\.json|clip-feedback\.json|instagram[^/]*/|media-originals/|sources/huawei/|work/moments/|public/media/)|^(media|work|index)/'
originals='\.(mp4|mov|m4v|avi|mkv|webm|ogv|flv|mts|m2ts|heic|raw|dng|cr2|cr3|psd|xcf)$'
while IFS= read -r -d '' file; do
  ((file_number += 1))
  if [[ $file =~ $credentials ]]; then
    block 'credential-looking file'
  elif [[ $file =~ $private_media || $file =~ $originals ]]; then
    block 'private review data or media; keep it outside Git'
  fi
  if ! bytes=$(git cat-file -s ":$file" 2>/dev/null); then
    block 'cannot read staged blob'
    continue
  fi
  if [[ $bytes -gt 1500000 ]]; then block 'staged blob over 1.5 MB'; fi
  if [[ $file == app/content/clips.json ]]; then
    if ! git show ':app/content/public-clip-data.ts' > "$scratch/public-clip-data.ts" 2>/dev/null; then
      block 'cannot read staged clip validator'
    elif ! git show ":$file" 2>/dev/null | node --input-type=module -e '
      import { readFileSync } from "node:fs"
      import { pathToFileURL } from "node:url"
      let clips, validate
      try { clips = JSON.parse(readFileSync(0, "utf8")) }
      catch { console.error("Public clips: invalid JSON."); process.exit(1) }
      try { ({ assertPublicClipData: validate } = await import(pathToFileURL(process.argv[1]).href)) }
      catch { console.error("Public clips: cannot load staged validator."); process.exit(1) }
      try { validate(clips) }
      catch (error) { console.error(error.message); process.exit(1) }
    ' "$scratch/public-clip-data.ts"; then fail=1; fi
  fi
done < "$scratch/staged"

# Scan additions only; the lockfile's generated text is not useful for these heuristics.
# Never print matching lines: the caller may be writing a public CI log.
patterns='(-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|xox[abp]-[A-Za-z0-9-]{10,}|sk_live_[A-Za-z0-9]+|sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|(CLOUDFLARE|CF)_API_(TOKEN|KEY)[[:space:]]*[=:][[:space:]]*[^[:space:]]+|(api[_-]?key|secret|token|password)["'"']?[[:space:]]*[:=][[:space:]]*["'"'][A-Za-z0-9/+_=-]{16,}["'"'])'
phones='(\(?[0-9]{3}\)?[ .-][0-9]{3}[ .-][0-9]{4}|\+55[ .-]?(\([0-9]{2}\)|[0-9]{2})[ .-]?9?[0-9]{4}[ .-]?[0-9]{4})'
patch=$(git diff --cached ${1:+"$1"} --no-ext-diff --no-textconv -U0 --diff-filter=ACMR -- . ':(exclude)package-lock.json')
added=$(grep '^+' <<< "$patch" | grep -v '^+++ ' || true)
if grep -Ei "$patterns" <<< "$added" > /dev/null; then
  echo 'Blocked: possible secret in staged changes.' >&2; fail=1
fi
if grep -E "$phones" <<< "$added" > /dev/null; then
  echo 'Blocked: phone-number-like text in staged changes.' >&2; fail=1
fi
exit "$fail"
